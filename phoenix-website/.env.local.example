# Copy this file to .env.local and fill in your own values.
# Find these in your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — NEVER expose this in client code or commit it.
# Used only by lib/supabaseAdmin.js (server-side) to power /admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Basic Auth for the /admin dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
